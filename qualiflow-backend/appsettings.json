{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=qualiflowdb;Username=postgres;Password=root;SSL Mode=Disable;"
  },
  "JwtSettings": {
    "SecretKey": "FROM_ENV",
    "Issuer": "FROM_ENV",
    "Audience": "FROM_ENV",
    "ExpirationInMinutes": 1440
  },
  "DemoAccounts": {
    "EnableDemoAccounts": true
  },
  "Storage": {
    "RootPath": "StorageFiles",
    "AllowedExtensions": ".pdf,.docx,.xlsx",
    "MaxFileSizeMb": 20,
    "OrganizationLogoMaxFileSizeMb": 5,
    "ProfilePhotoMaxFileSizeMb": 3,
    "PdfHeaderEnabled": true,
    "WordHeaderEnabled": true,
    "ExcelHeaderEnabled": true,
    "OrganizationLogosPath": "StorageFiles/organization-logos",
    "ProfilePhotosPath": "StorageFiles/profile-photos",
    "DefaultLogoPath": "../qualiflow-frontend/src/assets/logo.png"
  
  },
  "SmtpSettings": {
    "Enabled": true,
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "FROM_ENV",
    "Password": "FROM_ENV",
    "EnableSsl": true,
    "CheckCertificateRevocation": false,
    "FromEmail": "FROM_ENV",
    "FromName": "Qualiflow"
  },
  "RabbitMqSettings": {
    "Enabled": true,
    "Uri": "",
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "qualiflow",
    "Password": "qualiflow_password",
    "VirtualHost": "/",
    "QueueName": "qualiflow.notifications"
  },
  "SignalR": {
    "HubPath": "/hubs/notifications"
  },
  "Firebase": {
    "Enabled": false,
    "ServiceAccountPath": "firebase-admin.json",
    "ServiceAccountJson": "",
    "ProjectId": ""
  },
  "NotificationSettings": {
    "RealtimeEnabled": true,
    "DedupeWindowMinutes": 5
  },
  "SubscriptionMonitor": {
    "Enabled": true,
    "PollingIntervalMinutes": 60
  },
  "OpenRouter": {
    "ApiKey": "FROM_ENV",
    "Model": "llama-3.3-70b-versatile",
    "ApiBaseUrl": "https://api.groq.com/openai/v1",
    "TimeoutSeconds": 30,
    "Temperature": 0.2,
    "MaxOutputTokens": 1024
  },
  "SupportAssistant": {
    "Name": "Assistant Technique QualiFlow",
    "Email": "support.qualiflow@gmail.com",
    "Phone": "+216 29 677 374"
  },
  "AllowedHosts": "*"
}
