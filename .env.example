# ============================================================
# QualiFlow — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ─── Application ────────────────────────────────────────────
# Full public URL of your app (used in CORS and links)
APP_URL=http://yourdomain.com
HTTP_PORT=80

# ─── PostgreSQL ─────────────────────────────────────────────
POSTGRES_DB=qualiflowdb
POSTGRES_USER=qualiflow
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ─── RabbitMQ ───────────────────────────────────────────────
RABBITMQ_USER=qualiflow
RABBITMQ_PASS=CHANGE_ME_strong_rabbitmq_password

# ─── JWT ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_minimum_32_chars_random_secret_key
JWT_ISSUER=QualiFlow
JWT_AUDIENCE=QualiFlowUsers
JWT_EXPIRY=1440

# ─── SMTP Email ─────────────────────────────────────────────
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your@gmail.com

# ─── AI / Chatbot (Groq) ────────────────────────────────────
OPENROUTER_API_KEY=gsk_your_groq_api_key
OPENROUTER_MODEL=llama-3.3-70b-versatile
OPENROUTER_URL=https://api.groq.com/openai/v1

# ─── OneSignal Push Notifications (optional) ────────────────
ONESIGNAL_ENABLED=false
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# ─── Docker Image Registry (used in CI/CD) ──────────────────
# Set to your GHCR namespace: ghcr.io/your-github-username
REGISTRY=ghcr.io/your-github-username
TAG=latest
